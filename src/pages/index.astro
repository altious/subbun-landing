---
import Layout from "../layouts/Layout.astro";
import PricingCard from "../components/PricingCard.astro";
import FAQItem from "../components/FAQItem.astro";

// TODO: replace REPLACE with the Chrome Web Store extension ID after submission
const VIDEO_STORE = "https://chromewebstore.google.com/detail/subbun/REPLACE";

// Sites with verified text-caption support (Disney+/Niconico removed — unverified)
const sites = [
  "YouTube", "Netflix", "Amazon Prime", "Abema",
  "TVer", "NHK Plus", "U-NEXT", "Hulu Japan", "Crunchyroll"
];
---

<Layout>
  <!-- HERO -->
  <section id="install" class="container-narrow pt-16 pb-20 sm:pt-24">
    <div class="max-w-3xl">
      <span class="inline-block text-xs font-semibold tracking-wider uppercase text-accent mb-4">
        Chrome extension · 100% on-device
      </span>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.05] mb-6">
        Japanese video,
        <span class="text-accent">in English.</span>
      </h1>
      <p class="text-lg sm:text-xl text-ink-muted leading-relaxed mb-8 max-w-2xl">
        Watch Japanese TV, anime, and drama with instant English subtitles.
        Turn on Japanese captions on the site, and Subbun translates them live —
        entirely in your browser. Your content never leaves your computer.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href={VIDEO_STORE} class="btn-primary">
          Add to Chrome
        </a>
        <a href="#how-it-works" class="btn-secondary">
          See how it works
        </a>
      </div>
      <p class="text-xs text-ink-muted mt-4">
        Free on YouTube · 14-day Pro trial on every other site · No credit card required
      </p>
    </div>
  </section>

  <!-- CLICK COMPARISON -->
  <section id="how-it-works" class="border-y border-gray-100 bg-gray-50 py-16">
    <div class="container-narrow">
      <h2 class="text-3xl font-bold mb-3 text-center">
        Japanese TV in English — Abema, TVer, NHK, U-NEXT, Netflix.
      </h2>
      <p class="text-center text-ink-muted mb-12 max-w-xl mx-auto">
        No other extension reaches Japanese streaming sites. Subbun is the only way
        to watch Abema dramas, TVer catch-up, or NHK documentaries in English —
        without uploading your video to any server.
      </p>

      <div class="grid sm:grid-cols-3 gap-5 max-w-4xl mx-auto">
        <div class="rounded-2xl bg-white border border-gray-200 p-6">
          <div class="text-2xl mb-3">📺</div>
          <div class="font-semibold mb-2">Japanese TV sites</div>
          <div class="text-sm text-ink-muted">Abema, TVer, NHK Plus, U-NEXT — none supported by any other tool. Subbun reads captions directly from the player.</div>
        </div>
        <div class="rounded-2xl bg-white border border-gray-200 p-6">
          <div class="text-2xl mb-3">🔒</div>
          <div class="font-semibold mb-2">100% private</div>
          <div class="text-sm text-ink-muted">Translation runs in Chrome via on-device Gemini Nano. Subtitle text never leaves your machine — no API keys, no cloud calls.</div>
        </div>
        <div class="rounded-2xl bg-accent-soft border-2 border-accent p-6">
          <div class="text-2xl mb-3">🎯</div>
          <div class="font-semibold mb-2">Natural English</div>
          <div class="text-sm text-ink-muted">Learns character names and pronouns from each episode. Translates Japanese grammar in full sentences, not word-by-word.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE DEEP DIVE -->
  <section id="features" class="container-narrow py-20">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl sm:text-4xl font-extrabold mb-4 leading-tight">
          Live English subtitles, on every Japanese video site.
        </h2>
        <p class="text-ink-muted leading-relaxed mb-6">
          Turn on the platform's Japanese captions. Subbun reads them, translates them
          on-device with Chrome's built-in Gemini Nano AI, and overlays the English
          right under the video. No menus, no API keys, no setup.
        </p>

        <ul class="space-y-3 mb-8">
          <li class="flex gap-3">
            <span class="text-accent font-bold">✓</span>
            <span><strong class="text-ink">9 sites supported</strong> — including Abema, TVer, NHK Plus, and U-NEXT that no other tool reaches.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-accent font-bold">✓</span>
            <span><strong class="text-ink">Names and genders learned per episode</strong> — Misaki stays Misaki, pronouns are right for her character.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-accent font-bold">✓</span>
            <span><strong class="text-ink">Alt+E explain this line</strong> — pause and get a grammar breakdown in one keystroke.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-accent font-bold">✓</span>
            <span><strong class="text-ink">Netflix lines pre-translated</strong> — subtitles appear the moment a line starts, not after it finishes.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-accent font-bold">✓</span>
            <span><strong class="text-ink">100% on-device</strong> — subtitle text never leaves your machine. No servers, no API keys.</span>
          </li>
        </ul>
        <p class="text-xs text-ink-muted mb-6">
          Requires Japanese captions to be turned on in the video player.
          Needs Chrome 138+ on a desktop machine with ≥16 GB RAM and ≥22 GB free disk
          for the full Gemini Nano experience; a lighter translation mode works on most hardware.
        </p>

        <a href={VIDEO_STORE} class="btn-primary">Add to Chrome</a>
      </div>

      <!-- Static subtitle mock — swap for the 30-second demo .mp4 when recorded -->
      <div class="rounded-2xl bg-gray-900 aspect-video flex flex-col items-center justify-end pb-8 px-6 relative overflow-hidden">
        <div class="absolute top-4 left-4 flex items-center gap-2 text-white/30 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-red-500/70"></span> LIVE · ABEMA
        </div>
        <div class="text-center space-y-1.5">
          <div class="inline-block bg-black/60 text-white/80 text-sm px-3 py-1 rounded">
            田中さん、本当に大丈夫ですか？
          </div>
          <div class="block"></div>
          <div class="inline-block bg-black/60 text-white text-lg font-semibold px-4 py-1.5 rounded">
            Tanaka-san, are you really okay?
          </div>
        </div>
      </div>
    </div>

    <!-- Supported sites grid -->
    <div class="mt-16 pt-10 border-t border-gray-100">
      <div class="text-xs font-bold uppercase tracking-wide text-ink-muted mb-5 text-center">
        Works on
      </div>
      <div class="flex flex-wrap justify-center gap-3">
        {sites.map((s) => (
          <span class="px-4 py-2 rounded-full bg-white border border-gray-200 text-sm font-medium">
            {s}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="border-y border-gray-100 bg-gray-50 py-20">
    <div class="container-narrow">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-extrabold mb-3">Simple pricing.</h2>
        <p class="text-ink-muted">
          Free on YouTube forever. Pro unlocks every other supported site.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-6xl mx-auto">
        <PricingCard
          name="Free"
          price="$0"
          cadence="forever"
          description="YouTube only. Translation runs on your device."
          features={["YouTube unlimited", "All translation engines", "Native English subtitle overlay", "No card required"]}
          cta="Add to Chrome"
          ctaHref={VIDEO_STORE}
        />
        <PricingCard
          name="Pro Monthly"
          price="$4.99"
          cadence="/ month"
          description="Every supported site, full Gemini Nano translation."
          features={["All 9 sites unlocked", "Anime / drama / news presets", "Custom glossary + character names", "Alt+E explain this line", "Cancel anytime"]}
          cta="Start 14-day trial"
          ctaHref={VIDEO_STORE}
          featured={true}
          badge="14-day trial"
        />
        <PricingCard
          name="Pro Annual"
          price="$39"
          cadence="/ year"
          description="Same as monthly — about 35% off for the year."
          features={["Everything in Pro Monthly", "2 months+ free vs monthly", "60-day refund", "Cancel anytime"]}
          cta="Start 14-day trial"
          ctaHref={VIDEO_STORE}
        />
        <PricingCard
          name="Lifetime"
          price="$59"
          cadence="once"
          description="Founder deal — pay once, use forever. Price will rise."
          features={["Everything in Pro", "All future site additions", "60-day refund", "Audio Mode credits sold separately"]}
          cta="Get Lifetime"
          ctaHref={VIDEO_STORE}
        />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20">
    <div class="container-tight">
      <h2 class="text-3xl font-extrabold mb-2 text-center">Common questions</h2>
      <p class="text-center text-ink-muted mb-10">
        More on the <a href="/help" class="text-accent underline underline-offset-2">help page</a>.
      </p>

      <FAQItem q="Is translation really on-device? Where does my data go?">
        Yes. Subbun uses Chrome's built-in AI (Gemini Nano + Translator API), which
        runs in your browser process. Subtitle text never leaves your
        computer. The only thing we send to our servers is an anonymous license
        instance ID for Pro validation, and you can opt out of usage stats entirely.
      </FAQItem>

      <FAQItem q="What Chrome version do I need?">
        Chrome 138 or newer on desktop (Windows, macOS 13+, Linux, ChromeOS).
        Chrome for Android/iOS doesn't expose the on-device AI APIs yet, so the
        extension can't work there.
      </FAQItem>

      <FAQItem q="Will it work on Netflix / Crunchyroll / [specific site]?">
        Currently supported (9 sites): YouTube, Netflix, Amazon Prime, Abema,
        Crunchyroll, TVer, NHK Plus, U-NEXT, and Hulu Japan. Each site needs
        to expose Japanese subtitles as text in the DOM — we don't transcribe
        audio. If your favourite JP site isn't on the list, email us and we'll
        prioritize it.
      </FAQItem>

      <FAQItem q="Why isn't it free forever?">
        YouTube is free forever. We charge for the other sites because each one is
        ongoing engineering effort — sites change their player DOM regularly and we
        ship patches. The subscription funds the maintenance.
      </FAQItem>

      <FAQItem q="Can I cancel? Is there a refund?">
        Yes to both. Monthly cancellations take effect at the end of the billing
        cycle. Lemon Squeezy (our merchant of record) offers a no-questions
        60-day refund on lifetime and annual purchases.
      </FAQItem>

      <FAQItem q="Does it work outside Japan / with VPN?">
        Yes. Subbun runs entirely in your browser — there's no geo-restriction
        on our side. Some Japanese streaming sites (TVer, NHK Plus, U-NEXT) are
        themselves geo-restricted to Japan; using a VPN is between you and them.
      </FAQItem>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="border-t border-gray-100 bg-gray-50 py-20 text-center">
    <div class="container-narrow">
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">
        Watch Japanese the easy way.
      </h2>
      <p class="text-ink-muted mb-8 max-w-xl mx-auto">
        Free on YouTube. 14-day Pro trial on everything else. Install in 30 seconds.
      </p>
      <a href={VIDEO_STORE} class="btn-primary">Add to Chrome</a>
    </div>
  </section>
</Layout>
